# ── Database ────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ── JWT ─────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-long-random-secret-min-32-chars"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# ── Server ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Used by the production seed hook to create the initial administrator.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-16-character-password

# ── File Upload ──────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
